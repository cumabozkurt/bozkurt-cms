# BOZKURT CMS — Nginx örneği (VPS)
# server { ... } bloğunun içine ekleyin. PHP-FPM soket yolunu kendi sunucunuza göre değiştirin.

location ~ ^/(veri|bozkurt|sablonlar|testler|bin|docs|\.github)(/|$) { deny all; }
location ~ /\.(?!well-known/) { deny all; }
location ~ ^/(yonlendirici\.php|composer\.json|nginx\.conf\.ornek|phpstan\.neon\.dist)$ { deny all; }
location ~* ^/yuklemeler/.*\.(php\d?|phtml|phar|pl|py|cgi|sh|html?|svg)$ { deny all; }
location ~* \.(sqlite|sqlite-wal|sqlite-shm|log|kilit|sql)$ { deny all; }
# Diskteki .md/.json/.yml dosyaları doğrudan servis edilmez; sanal /sayfa.md adresleri index.php'ye gider
location ~* \.(md|json|lock|dist|ornek|yml)$ { rewrite ^ /index.php last; }

location / { try_files $uri $uri/ /index.php?$query_string; }
location /yonetim/ { try_files $uri $uri/ /yonetim/index.php?$query_string; }

