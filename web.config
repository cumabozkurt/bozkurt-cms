<?xml version="1.0" encoding="UTF-8"?>
<!-- BOZKURT CMS — Windows/IIS (Plesk) hostingler için -->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <rewrite>
      <rules>
        <rule name="Korunan" stopProcessing="true">
          <match url="^(veri|bozkurt|sablonlar|testler|bin|docs|\.github)(/|$)|(^|/)\.(?!well-known/)" />
          <action type="CustomResponse" statusCode="403" />
        </rule>
        <!-- Kök dizindeki geliştirme/yapılandırma dosyaları servis edilmez -->
        <rule name="KorunanDosyalar" stopProcessing="true">
          <match url="^(yonlendirici\.php|composer\.json|nginx\.conf\.ornek|phpstan\.neon\.dist)$" />
          <action type="CustomResponse" statusCode="403" />
        </rule>
        <!-- Yüklenen dosyalar asla betik olarak çalıştırılmaz / HTML olarak sunulmaz -->
        <rule name="YuklemelerBetik" stopProcessing="true">
          <match url="^yuklemeler/.*\.(php\d?|phtml|phar|pl|py|cgi|sh|html?|svg)$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" />
        </rule>
        <!-- Sunucudaki gerçek .md/.json/.yml dosyaları servis edilmez (sanal /sayfa.md adresleri çalışır) -->
        <rule name="GercekMetinDosyalari" stopProcessing="true">
          <match url="\.(md|json|lock|dist|ornek|yml|sqlite|sqlite-wal|sqlite-shm|log|kilit|sql)$" ignoreCase="true" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="CustomResponse" statusCode="403" />
        </rule>
        <rule name="BOZKURT" stopProcessing="true">
          <match url="^(.*)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
